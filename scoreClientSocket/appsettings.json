{
  "Version": 10.0,
  "DevelopmentVersion": 16,
  "ServerName": "Score Client Socket",
  "Port": "",
  "SwaggerSettings": {
    "EnableSwagger": true
  },
  "Hubettings": {
    "HubName": "clientScore",
    "HubKeepLiveSecond": 20
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "isActive": true,
    "PermitLimit": 5,
    "WindowSeconds": 1
  },
  // ScoreProvider connects to THIS hub as a client (RegisterAsUpstream) and pushes data in.
  // No URL needed here — the connection is initiated by ScoreProvider's ScoreProviderSockets config.
  "ScoreProvider": {
    "BaseUrl": "https://scoreprovider-api-wspju3x7mq-lz.a.run.app"
  },
  "ScorecardCache": {
    "LinkTtlMinutes": 30
  },
  "UpdateScoreBatch": {
    "IntervalSeconds": 30
  },
  // Pulls fresh score data from ScoreProvider's HTTP API (POST /api/EventInfoBulk) for events
  // with recent local client interest, updates the local event cache, and broadcasts changes.
  "ScorePoll": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "ActiveWindowSeconds": 90,
    "MaxEventIdsPerRequest": 30
  },
  // Forcefully (gracefully) stop an instance that has had 0 end-client connections
  // for IdleTimeoutSeconds, so idle Cloud Run instances drain. Disabled by default.
  // MinActiveInstances keeps that many instances warm (never scales below it).
  "IdleShutdown": {
    "Enabled": false,
    "IdleTimeoutSeconds": 300,
    "StartupGraceSeconds": 300,
    "CheckIntervalSeconds": 30,
    "MinActiveInstances": 1,
    "MaxJitterSeconds": 30
  },
  // Gates AgentAuthFilter: every /api/* call and the SignalR hub's negotiate/WebSocket-upgrade
  // request must present a key (header "KeyHeader" below, or "?key=" query string) matching a
  // non-expired entry in "Agents". If that agent's AllowedIPs is non-empty, the caller IP must
  // also be in it — empty AllowedIPs means the agent is allowed from any IP.
  "AgentAuth": {
    "isActive": true,
    "KeyHeader": "X-App"
  },
  "Agents": [
    {
      "Name": "score",
      "Key": "123456",
      "ExpiryDate": "2080-12-31",
      "AllowedProvider": [],
      "AllowedIPs": []
    },
    {
      "Name": "demo",
      "Key": "456878",
      "ExpiryDate": "2026-02-28",
      "AllowedProvider": [],
      "AllowedIPs": []
    },
    {
      "Name": "score-webapp",
      "Key": "wa_9f2c7ab13e4d4b0a",
      "ExpiryDate": "2080-12-31",
      "AllowedProvider": [],
      "AllowedIPs": []
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}